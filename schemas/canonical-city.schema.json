{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streetsofturkiye.com/schemas/canonical-city.schema.json",
  "title": "Streets of Türkiye Canonical City Content",
  "type": "object",
  "required": [
    "schemaVersion",
    "contentAuthority",
    "source",
    "id",
    "order",
    "name",
    "regionId",
    "coordinates",
    "legacyGuideId",
    "stops",
    "quiz"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "contentAuthority": {
      "const": "index-html-canonical"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 81
    },
    "regionId": {
      "type": "string"
    },
    "legacyGuideId": {
      "enum": [
        "keloglan",
        "nasreddin-hoca"
      ]
    },
    "stops": {
      "type": "array",
      "minItems": 1
    },
    "quiz": {
      "type": "array",
      "minItems": 1
    }
  }
}
