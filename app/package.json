{
  "name": "streets-of-turkiye",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "npm run content:sync && next dev",
    "build": "npm run content:sync && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run content:sync && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:sync": "node scripts/sync-content.mjs",
    "content:check": "node scripts/validate-canonical.mjs && node scripts/sync-content.mjs --check",
    "content:scenes": "node scripts/build-scenes.mjs",
    "content:baseline": "node scripts/validate-canonical.mjs --write-baseline",
    "assets:registry": "node scripts/build-asset-registry.mjs ../asset-manifests/pilot-assets.csv",
    "gate": "npm run content:sync && npm run content:check && npm run lint && npm run typecheck && vitest run && next build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "private": true
}