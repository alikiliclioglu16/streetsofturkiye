      },
      "category": "craft",
      "title": {
        "en": "Nazarköy — the Evil Eye Village",
        "tr": null
      },
      "description": {
        "en": "In this little village, glass masters melt glass over a fire and shape the famous blue evil eye beads — 'nazar boncuğu'. They even hang on trees! People believe the friendly blue eye protects you from bad luck.",
        "tr": null
      },
      "reward": {
        "emoji": "🧿",
        "label": {
          "en": "an evil eye bead",
          "tr": null
        }
      },
      "guideLine": {
        "text": {
          "en": "Pick a bead from the wishing tree! Blue like the Aegean Sea.",
          "tr": null
        },
        "source": "explicit-city-stop"
      }
    },
    {
