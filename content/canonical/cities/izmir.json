        "tr": null
      },
      "description": {
        "en": "İzmir kids start the day with boyoz — a flaky, swirly pastry — best eaten by the sea on the Kordon, where everyone walks, bikes and watches the waves. Afiyet olsun — enjoy!",
        "tr": null
      },
      "reward": {
        "emoji": "🥐",
        "label": {
          "en": "a warm boyoz",
          "tr": null
        }
      },
      "guideLine": {
        "text": {
          "en": "One for you, one for me… and a crumb for the seagull!",
          "tr": null
        },
