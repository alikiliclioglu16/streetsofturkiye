        "type": "theatre",
        "params": {}
      },
      "category": "history",
      "title": {
        "en": "The Great Theatre of Ephesus",
        "tr": null
      },
      "description": {
        "en": "This huge stone theatre could seat 24,000 people on its curved rows! It was built so cleverly that even a whisper on the stage can be heard at the very top. Concerts still happen here!",
        "tr": null
      },
      "reward": {
        "emoji": "🎭",
        "label": {
          "en": "a theatre mask",
          "tr": null
        }
      },
      "guideLine": {
        "text": {
          "en": "Stand on the stage and whisper 'Merhaba!' — I'll hear it from the top row!",
          "tr": null
        },
        "source": "explicit-city-stop"
      }
    },
    {
      "id": "izmir-stop-03",
