        "type": "clock",
        "params": {}
      },
      "category": "history",
      "title": {
        "en": "The Clock Tower of Konak Square",
        "tr": null
      },
      "description": {
        "en": "This elegant white marble tower from 1901 is the symbol of İzmir. The square around it is full of friendly pigeons — hold out some seeds and they might land right on your arm!",
        "tr": null
      },
      "reward": {
        "emoji": "🕊️",
        "label": {
          "en": "a pigeon feather",
          "tr": null
        }
      },
      "guideLine": {
        "text": {
          "en": "Quick, what time is it? The tower never lies!",
          "tr": null
        },
        "source": "explicit-city-stop"
      }
    },
    {
