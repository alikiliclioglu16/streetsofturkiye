      "title": {
        "en": "Ephesus — the Celsus Library",
        "tr": null
      },
      "description": {
        "en": "Ephesus is a 2,000-year-old city where you can still walk the marble streets! This is its most famous building: the two-story Celsus Library, which once held 12,000 scrolls.",
        "tr": null
      },
      "reward": {
        "emoji": "📜",
        "label": {
          "en": "an ancient scroll",
          "tr": null
        }
      },
      "guideLine": {
        "text": {
          "en": "Imagine — kids just like you walked this very street 2,000 years ago!",
          "tr": null
        },
        "source": "explicit-city-stop"
      }
    },
    {
