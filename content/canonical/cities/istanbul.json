      "reward": {
        "emoji": "🪔",
        "label": {
          "en": "a mosaic lamp",
          "tr": null
        }
      },
      "guideLine": {
        "text": {
          "en": "Hold my hand — it's easy to get lost in 4,000 shops!",
          "tr": null
        },
        "source": "explicit-city-stop"
      }
